---
import Layout from '../layouts/Layout.astro';
import CTABanner from '../components/CTABanner.astro';
import FAQ from '../components/FAQ.astro';
import { SITE, COMPANY } from '../data/site';
import Icon, { type IconName } from '../components/Icon.astro';

// "For your home / For your business" chooser under the hero, so visitors see only the
// services that apply to them (households can't switch water) and the right next step.
// Businesses go straight to Microsoft Bookings (as on /contact), with the form as a
// fallback; ?type= pre-selects home/business on the contact form.
const bookingsUrl = import.meta.env.PUBLIC_BOOKINGS_URL;
type AudienceLink = { label: string; href: string; external?: boolean };
const audiences: {
  title: string;
  intro: string;
  items: { label: string; href: string; icon: IconName }[];
  note?: string;
  primary: AudienceLink;
  secondary?: AudienceLink;
}[] = [
  {
    title: 'For your home',
    intro: 'Homeowners and tenants',
    items: [
      { label: 'Electricity & gas', href: '/utilities', icon: 'bolt' },
      { label: 'Solar & battery storage', href: '/solar', icon: 'sun' },
      { label: 'Trades for repairs & renovations', href: '/fixtures', icon: 'wrench' },
    ],
    note: "UK law doesn't let households switch water supplier, so our water service is for businesses only.",
    primary: { label: 'Book a Free Consultation', href: '/contact?type=home' },
  },
  {
    title: 'For your business',
    intro: 'Sole traders, SMEs and multi-site businesses',
    items: [
      { label: 'Electricity & gas', href: '/utilities', icon: 'bolt' },
      { label: 'Business water', href: '/utilities', icon: 'water' },
      { label: 'Solar', href: '/solar', icon: 'sun' },
      { label: 'Fit-outs, repairs & compliance work', href: '/fixtures', icon: 'wrench' },
      { label: 'Multi-site management', href: '/utilities', icon: 'building' },
    ],
    primary: bookingsUrl
      ? { label: 'Book a Free Consultation', href: bookingsUrl, external: true }
      : { label: 'Book a Free Consultation', href: '/contact?type=business' },
    secondary: bookingsUrl ? { label: 'or send us an enquiry', href: '/contact?type=business' } : undefined,
  },
];

const services: { name: string; href: string; description: string; icon: IconName }[] = [
  {
    name: 'Solar',
    href: '/solar',
    description: 'Installation, financing and battery storage guidance to lower bills and protect against rising prices.',
    icon: 'sun',
  },
  {
    name: 'Utilities',
    href: '/utilities',
    description: 'Electricity, gas and business water — whole-of-market comparisons with ongoing contract management.',
    icon: 'bolt',
  },
  {
    name: 'Fixtures',
    href: '/fixtures',
    description: 'Vetted trades and contractors for fit-outs, renovations, repairs and compliance work — one point of contact.',
    icon: 'wrench',
  },
];

const steps = [
  {
    title: 'Book a Call',
    description: 'Tell us about your energy, water, solar or trades needs. No pressure, no obligation.',
  },
  {
    title: 'We Get to Work',
    description: 'With your Letter of Authority, we compare the whole market and negotiate on your behalf.',
  },
  {
    title: 'You Save',
    description: 'We present clear options, handle the switch, and stay on hand for ongoing support.',
  },
];

const trustPoints: { title: string; description: string; icon: IconName }[] = [
  {
    title: 'Whole-of-market comparison',
    description: 'We are not tied to any single supplier, so recommendations are based on what suits you — not a target.',
    icon: 'compare',
  },
  {
    title: 'No instant, meaningless quotes',
    description: "We won't guess at a number before understanding your usage and contract position properly.",
    icon: 'target',
  },
  {
    title: 'Ongoing account management',
    description: "We track renewal dates so you don't get caught out by auto-renewals or out-of-contract rates.",
    icon: 'clock',
  },
  {
    title: 'Straight-talking, no jargon',
    description: 'Clear explanations of your options, in plain English, from someone who has managed hundreds of accounts.',
    icon: 'chat',
  },
];

const faqs = [
  {
    question: 'Why can\'t you just give me a quote online?',
    answer:
      "Because it wouldn't be accurate or honest. Energy, water and solar pricing depends on your usage, location, contract terms and supplier appetite on the day — a generic online number is essentially a guess. We start with a short call and a Letter of Authority (LOA), which lets us pull your real contract details and get genuine, comparable pricing from the whole market.",
  },
  {
    question: 'What is a Letter of Authority (LOA)?',
    answer:
      'An LOA is a simple, standard document that authorises us to speak to your current supplier(s) on your behalf and access your account details. It does not commit you to switching anything — it just allows us to do the groundwork properly.',
  },
  {
    question: 'Is there any obligation to switch after speaking to you?',
    answer:
      'None at all. We will lay out your options honestly, including where staying put is the right call. You only proceed if it makes sense for you.',
  },
  {
    question: 'Do you work with homeowners and businesses?',
    answer:
      'Yes. We support homeowners on energy and solar, and businesses/SMEs on energy, business water, solar and fixtures/trades sourcing. Note that UK households cannot switch water suppliers by law — our water service is for business customers only, and in Wales only the largest sites (over 50 million litres a year) can switch.',
  },
  {
    question: 'How do you get paid?',
    answer:
      "We're paid a commission by the supplier or contractor once a deal completes. That commission is included in the price you pay — built into your unit rates or the contractor's quote, rather than charged to you separately — and we'll always tell you exactly how much it is before you agree to anything.",
  },
];

// Structured data (schema.org JSON-LD) describing the business for search engines. Built
// from site.ts so it always matches what the site shows. Deliberately an Organization with
// no street address: the Google Business Profile is a service-area business.
const siteUrl = `${SITE.url}/`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: SITE.name,
      legalName: COMPANY.legalName,
      url: siteUrl,
      logo: `${SITE.url}/icon-512.png`,
      description: SITE.tagline,
      email: SITE.email,
      telephone: SITE.phoneHref.replace('tel:', ''),
      areaServed: { '@type': 'Country', name: 'United Kingdom' },
      identifier: { '@type': 'PropertyValue', propertyID: 'Companies House company number', value: COMPANY.number },
      sameAs: [COMPANY.companiesHouseUrl, COMPANY.icoRegisterUrl],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: SITE.name,
      url: siteUrl,
      publisher: { '@id': `${siteUrl}#organization` },
    },
  ],
};
---

<Layout
  title="Independent UK Energy, Water, Solar & Trades Brokerage"
  description="MA Utility Solutions is an independent, whole-of-market UK brokerage helping homeowners and businesses secure better deals on energy, water, solar and trusted trades. Book a free consultation."
>
  <!-- JSON-LD is a data block, not executable script, so the CSP's script-src doesn't apply. -->
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy">
    <img
      src="/home-hero.jpg"
      alt="Installer's gloved hands fitting solar panels on a rooftop"
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-navy/75" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute inset-0 opacity-20"
      style="background-image: radial-gradient(circle at 20% 20%, #F59E0B 0, transparent 40%), radial-gradient(circle at 85% 60%, #F59E0B 0, transparent 35%);"
      aria-hidden="true"
    >
    </div>
    <div class="container-page relative grid gap-12 py-20 sm:py-24 lg:grid-cols-2 lg:items-center lg:py-28">
      <div>
        <span class="eyebrow-inverse">Independent &amp; whole-of-market</span>
        <h1 class="mt-5 text-4xl font-extrabold leading-tight text-white sm:text-5xl">
          Smarter deals on energy, water, solar and trades — without the sales pitch.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/75">
          We compare the whole market on your behalf and manage the switch end-to-end. No instant quotes, no
          auto-renewal traps — just a proper conversation and a plan that works for you.
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href="/contact" class="btn-primary px-8 py-3.5 text-base">Book a Free Consultation</a>
          <a href="/about" class="btn-outline-light">Learn about us</a>
        </div>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-8 backdrop-blur">
        <dl class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-2">
          <div>
            <dt class="text-sm font-medium text-white/60">Accounts managed</dt>
            <dd class="mt-1 text-3xl font-extrabold text-amber">300+</dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-white/60">Market coverage</dt>
            <dd class="mt-1 text-3xl font-extrabold text-amber">100%</dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-white/60">Services</dt>
            <dd class="mt-1 text-3xl font-extrabold text-amber">4</dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-white/60">Obligation to switch</dt>
            <dd class="mt-1 text-3xl font-extrabold text-amber">None</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Who we help: home vs business -->
  <section class="pt-14 sm:pt-20 lg:pt-24">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow">Who we help</span>
        <h2 class="mt-4 text-3xl font-extrabold sm:text-4xl">Start with who it's for</h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {
          audiences.map((audience) => (
            <div class="card flex flex-col">
              <h3 class="text-2xl font-extrabold text-navy">{audience.title}</h3>
              <p class="mt-1 text-sm text-ink-light">{audience.intro}</p>
              <ul class="mt-6 space-y-3">
                {audience.items.map((item) => (
                  <li>
                    <a href={item.href} class="group flex items-center gap-3 text-sm font-semibold text-navy hover:text-amber-ink">
                      <span class="inline-flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-amber/15 text-amber-dark">
                        <Icon name={item.icon} class="h-5 w-5" />
                      </span>
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
              {audience.note && <p class="mt-5 text-xs leading-relaxed text-ink-light">{audience.note}</p>}
              <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-8">
                <a
                  href={audience.primary.href}
                  class="btn-primary"
                  {...(audience.primary.external && { target: '_blank', rel: 'noopener noreferrer' })}
                >
                  {audience.primary.label}
                </a>
                {audience.secondary && (
                  <a href={audience.secondary.href} class="text-sm font-semibold text-navy underline hover:text-amber-ink">
                    {audience.secondary.label}
                  </a>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Services overview -->
  <section class="section-padding">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow">What we help with</span>
        <h2 class="mt-4 text-3xl font-extrabold sm:text-4xl">How we save you time and money</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service) => (
            <a href={service.href} class="card group flex flex-col transition hover:shadow-card-hover">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-amber/15 text-amber-dark">
                <Icon name={service.icon} class="h-6 w-6" />
              </span>
              <h3 class="mt-5 text-xl font-bold text-navy">{service.name}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-light">{service.description}</p>
              <span class="mt-5 inline-flex items-center gap-1 text-sm font-bold text-amber-ink group-hover:gap-2 transition-all">
                Learn more
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section-padding bg-white">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow">How it works</span>
        <h2 class="mt-4 text-3xl font-extrabold sm:text-4xl">Three simple steps</h2>
      </div>
      <div class="mt-12 grid gap-8 sm:grid-cols-3">
        {
          steps.map((step, index) => (
            <div class="relative text-center">
              <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-navy text-xl font-extrabold text-amber">
                {index + 1}
              </div>
              <h3 class="mt-5 text-lg font-bold text-navy">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-light">{step.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="section-padding">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow">Why choose us</span>
        <h2 class="mt-4 text-3xl font-extrabold sm:text-4xl">Built around trust, not targets</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          trustPoints.map((point) => (
            <div class="card flex gap-4">
              <span class="mt-1 inline-flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-amber/15 text-amber-dark">
                <Icon name={point.icon} class="h-5 w-5" />
              </span>
              <div>
                <h3 class="text-base font-bold text-navy">{point.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-ink-light">{point.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-padding bg-white">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow">FAQ</span>
        <h2 class="mt-4 text-3xl font-extrabold sm:text-4xl">Common questions</h2>
      </div>
      <div class="mx-auto mt-12 max-w-3xl">
        <FAQ items={faqs} />
      </div>
    </div>
  </section>

  <CTABanner />
</Layout>
