---
import Layout from '../../layouts/Layout.astro';
import CTABanner from '../../components/CTABanner.astro';
import { render } from 'astro:content';
import { getGuides, AUDIENCE_LABELS } from '../../lib/guides';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const updated = guide.data.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const pageUrl = new URL(`/guides/${guide.id}/`, Astro.site).href;

// Article structured data, so search engines understand what the page is and who wrote it.
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.data.title,
  description: guide.data.description,
  dateModified: guide.data.updated.toISOString().slice(0, 10),
  mainEntityOfPage: pageUrl,
  author: { '@type': 'Organization', name: SITE.name, url: `${SITE.url}/` },
  publisher: { '@id': `${SITE.url}/#organization` },
};
---

<Layout title={guide.data.title} description={guide.data.description} noindex={guide.data.draft}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <section class="bg-navy">
    <div class="container-page section-padding text-center">
      <span class="eyebrow-inverse">{AUDIENCE_LABELS[guide.data.audience]}</span>
      <h1 class="mx-auto mt-5 max-w-3xl text-3xl font-extrabold text-white sm:text-4xl">{guide.data.title}</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/75">{guide.data.description}</p>
      <p class="mt-4 text-sm text-white/60">Updated {updated}</p>
      {
        guide.data.draft && (
          <p class="mx-auto mt-6 inline-flex rounded-full bg-red-50 px-4 py-1.5 text-xs font-bold uppercase text-red-700">
            Draft — only visible in local preview, not on the live site
          </p>
        )
      }
    </div>
  </section>

  <section class="section-padding">
    <div class="container-page">
      <article class="guide-content mx-auto max-w-3xl">
        <Content />
      </article>
      <p class="mx-auto mt-12 max-w-3xl border-t border-navy/10 pt-6 text-xs leading-relaxed text-ink-light">
        This guide is general information to help you understand your options. It isn't advice about your specific
        situation, and it doesn't include prices — those depend on your contract, usage and the market on the day.
        Rules and market conditions change, so we'll always check the details for your circumstances.
        <a href="/guides/" class="font-semibold text-navy underline hover:text-amber-ink">All guides</a>
      </p>
    </div>
  </section>

  <CTABanner />
</Layout>
