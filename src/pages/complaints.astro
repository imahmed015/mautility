---
import Layout from '../layouts/Layout.astro';
import AdrBadge from '../components/AdrBadge.astro';
import { SITE } from '../data/site';

const processSteps = [
  {
    title: 'Acknowledgement',
    timing: 'Within 5 working days',
    description: "We'll confirm we've received your complaint and let you know who is handling it.",
  },
  {
    title: 'Investigation',
    timing: 'Ongoing',
    description: "We'll look into what happened, speak to anyone involved, and keep you updated on progress.",
  },
  {
    title: 'Resolution',
    timing: 'Within 20 working days',
    description: "We'll write to you with our findings and, where appropriate, what we'll do to put things right.",
  },
];
---

<Layout
  title="Complaints Procedure"
  description="How to make a complaint to MA Utility Solutions and what happens next: acknowledgement within 5 working days and resolution within 20 working days."
>
  <section class="bg-navy">
    <div class="container-page section-padding text-center">
      <span class="eyebrow">Complaints</span>
      <h1 class="mx-auto mt-5 max-w-2xl text-4xl font-extrabold text-white sm:text-5xl">Complaints Procedure</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/75">
        If something hasn't gone the way it should, we want to know. Here's exactly how to tell us and what happens
        next.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-page grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-extrabold text-navy">How to complain</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-light sm:text-base">
          You can raise a complaint with us in whichever way is easiest for you:
        </p>
        <ul class="mt-6 space-y-4">
          <li class="card flex items-center gap-4">
            <span class="inline-flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-amber/15 text-amber-dark">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </span>
            <div>
              <p class="text-sm font-semibold text-navy">Email</p>
              <a href={`mailto:${SITE.complaintsEmail}`} class="text-sm text-ink-light hover:text-amber-dark">{SITE.complaintsEmail}</a>
            </div>
          </li>
          <li class="card flex items-center gap-4">
            <span class="inline-flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-amber/15 text-amber-dark">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </span>
            <div>
              <p class="text-sm font-semibold text-navy">Phone</p>
              <a href={SITE.phoneHref} class="text-sm text-ink-light hover:text-amber-dark">{SITE.phone}</a>
            </div>
          </li>
        </ul>
        <p class="mt-6 text-sm leading-relaxed text-ink-light">
          Please include your name, contact details, and as much detail as possible about what happened and when —
          it helps us investigate quickly and fairly.
        </p>

        <!-- ADR accreditation placeholder — hidden until membership is confirmed. -->
        <AdrBadge />
      </div>

      <div>
        <h2 class="text-2xl font-extrabold text-navy">Our process</h2>
        <ol class="mt-6 space-y-6">
          {
            processSteps.map((step, index) => (
              <li class="card flex gap-4">
                <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-navy text-base font-extrabold text-amber">
                  {index + 1}
                </span>
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="text-base font-bold text-navy">{step.title}</h3>
                    <span class="chip text-xs">{step.timing}</span>
                  </div>
                  <p class="mt-1.5 text-sm leading-relaxed text-ink-light">{step.description}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="mt-8 rounded-xl border border-navy/10 bg-white p-5">
          <h3 class="text-base font-bold text-navy">Our commitment</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-light">
            We take every complaint seriously and treat it as a genuine opportunity to put things right and improve
            how we work. You will always be kept informed of progress, and we will explain our reasoning clearly if
            we are unable to resolve things exactly as you'd hoped.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
