---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
import { SITE } from '../data/site';

const bookingsUrl = import.meta.env.PUBLIC_BOOKINGS_URL || '#';
---

<Layout
  title="Contact Us"
  description="Get in touch with MA Utility Solutions. Home and private customers can send an enquiry; business and SME customers can book a free consultation directly."
>
  <section class="bg-navy">
    <div class="container-page section-padding text-center">
      <span class="eyebrow">Contact</span>
      <h1 class="mx-auto mt-5 max-w-2xl text-4xl font-extrabold text-white sm:text-5xl">Let's have a conversation</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/75">
        We don't do instant online quotes — pricing depends on your actual contract, usage and circumstances. Every
        engagement starts with a short conversation and, where needed, a Letter of Authority (LOA) so we can get you
        genuine, accurate options from across the whole market.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-page grid gap-8 lg:grid-cols-2 lg:items-start">
      <!-- Home / Private customers -->
      <div class="card">
        <span class="eyebrow">Home &amp; private customers</span>
        <h2 class="mt-4 text-2xl font-extrabold text-navy">Send us an enquiry</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-light">
          Fill in the form below and we'll get back to you to arrange your free, no-obligation consultation.
        </p>
        <div class="mt-6">
          <ContactForm client:load />
        </div>
      </div>

      <!-- Business / SME customers -->
      <div class="card flex flex-col">
        <span class="eyebrow">Business &amp; SME customers</span>
        <h2 class="mt-4 text-2xl font-extrabold text-navy">Book a free consultation</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-light">
          For businesses, the fastest route is to book directly into our calendar. We'll use the call to understand
          your sites, contracts and priorities before recommending anything.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-ink-light">
          <li class="flex items-start gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 flex-shrink-0 text-amber-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Pick a time that suits you — no back-and-forth emails.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 flex-shrink-0 text-amber-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>15–20 minutes to understand your current contracts and priorities.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 flex-shrink-0 text-amber-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>No obligation, and no pricing given until we've reviewed your actual details.</span>
          </li>
        </ul>
        <div class="mt-8">
          <a href={bookingsUrl} target="_blank" rel="noopener noreferrer" class="btn-primary w-full">
            Book a Free Consultation
          </a>
          <p class="mt-3 text-xs text-ink-light">Opens our Microsoft Bookings calendar in a new tab.</p>
        </div>
        <div class="mt-auto pt-8">
          <p class="text-sm text-ink-light">
            Prefer email? Reach us at
            <a href={`mailto:${SITE.email}`} class="font-semibold text-amber-dark hover:underline">{SITE.email}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
