---
interface Props {
  heading?: string;
  subheading?: string;
  buttonLabel?: string;
  buttonHref?: string;
}

const {
  heading = "Ready to stop overpaying?",
  subheading = "Book a free, no-obligation consultation and we'll tell you honestly whether we can help.",
  buttonLabel = 'Book a Free Consultation',
  buttonHref = '/contact',
} = Astro.props;
---

<section class="bg-navy">
  <div class="container-page section-padding text-center">
    <h2 class="text-3xl font-extrabold text-white sm:text-4xl">{heading}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-white/75 sm:text-lg">{subheading}</p>
    <div class="mt-8">
      <a href={buttonHref} class="btn-primary px-8 py-3.5 text-base">{buttonLabel}</a>
    </div>
  </div>
</section>
