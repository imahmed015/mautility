---
// Business credentials / accreditation trust signals, shown as a row of small
// badge-style items. Used on the About page (full-size) and, compactly, in the
// footer — see the `compact` prop.
//
// These are real, confirmed reference numbers. Keep this list accurate — no VAT
// number (the business isn't VAT registered) and no supplier-platform memberships
// (e.g. OnlineDIRECT); those aren't meant to be public.
//
// The DRO/ADR line here is a simple text credential, distinct from <AdrBadge /> —
// that component is a larger callout (used on /complaints) that also carries the
// verification link; this one is just the compact "we're accredited" signal.
import Icon, { type IconName } from './Icon.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const credentials: { label: string; value: string; icon: IconName }[] = [
  { label: 'Company No.', value: '17283404', icon: 'building' },
  { label: 'ICO Registered', value: 'ZC203801', icon: 'shield-check' },
  { label: 'DRO Accredited', value: 'Member E3593', icon: 'badge-check' },
];
---

<div class:list={['flex flex-wrap items-center gap-3', compact ? 'justify-center sm:justify-start' : 'justify-center']}>
  {
    credentials.map((credential) => (
      <div
        class:list={[
          'inline-flex items-center gap-2 rounded-full ring-1',
          compact ? 'bg-white/5 px-3.5 py-1.5 ring-white/15' : 'bg-navy/5 px-4 py-2 ring-navy/10',
        ]}
      >
        <Icon name={credential.icon} class:list={['h-4 w-4 flex-shrink-0', compact ? 'text-amber' : 'text-amber-dark']} />
        <span class:list={['text-xs font-semibold sm:text-sm', compact ? 'text-white' : 'text-navy']}>
          {credential.label}
          <span class:list={['font-normal', compact ? 'text-white/70' : 'text-ink-light']}> — {credential.value}</span>
        </span>
      </div>
    ))
  }
</div>
