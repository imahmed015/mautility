---
// FAQ accordion built on native <details>/<summary> — no JavaScript (this replaced a React
// island that loaded React on the homepage just for this). Sharing one `name` across the
// <details> elements makes them exclusive (opening one closes the others) in current
// browsers; older browsers simply allow several open at once. The first item starts open.
import Icon from './Icon.astro';

export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  // Groups the <details> so only one is open at a time; unique per accordion on a page.
  name?: string;
}

const { items, name = 'faq' } = Astro.props;
---

<div class="divide-y divide-navy/10 rounded-2xl border border-navy/10 bg-white shadow-card">
  {
    items.map((item, index) => (
      <details name={name} open={index === 0} class="group">
        <summary class="flex w-full cursor-pointer list-none items-center justify-between gap-4 px-5 py-5 text-left sm:px-6 [&::-webkit-details-marker]:hidden">
          <span class="text-base font-semibold text-navy sm:text-lg">{item.question}</span>
          <Icon
            name="chevron-down"
            class="h-5 w-5 flex-shrink-0 text-amber-dark transition-transform duration-200 group-open:rotate-180"
          />
        </summary>
        <div class="px-5 pb-5 text-sm leading-relaxed text-ink-light sm:px-6 sm:text-base">{item.answer}</div>
      </details>
    ))
  }
</div>
