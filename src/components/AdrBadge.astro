---
// ADR (Alternative Dispute Resolution) accreditation badge — The Dispute Resolution
// Ombudsman. Membership is confirmed (member number in COMPANY, site.ts), so this is
// switched on across every page that renders <AdrBadge /> (currently only /complaints).
//
// badgeHref points at DRO's public site rather than a per-member verification page —
// we don't have one of those.
import { COMPANY } from '../data/site';

const ENABLED = true;
const badgeName = COMPANY.adrScheme;
const badgeHref = COMPANY.adrSchemeUrl;
// Artwork supplied by DRO — a wide wordmark logo (198x50px, ~4:1). Sized by height with
// w-auto so it keeps its own aspect ratio rather than stretching; width/height attrs
// below are the real intrinsic size (aspect-ratio hint to avoid layout shift), while the
// h-9 class is what actually controls the rendered size next to the two lines of text.
const badgeImageSrc = '/dro-badge.png';
---

{
  ENABLED && (
    <div class="mt-6 flex items-center gap-3 rounded-xl border border-navy/10 bg-white p-4">
      {badgeImageSrc && (
        <img
          src={badgeImageSrc}
          width="198"
          height="50"
          alt={`${badgeName} accreditation badge`}
          class="h-9 w-auto flex-shrink-0"
        />
      )}
      <div>
        <p class="text-sm font-semibold text-navy">Accredited member</p>
        <a href={badgeHref} class="text-sm text-ink-light underline hover:text-amber-ink" target="_blank" rel="noopener noreferrer">
          {badgeName}
        </a>
      </div>
    </div>
  )
}
