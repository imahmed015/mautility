# Cloudflare Pages custom headers — applied to every response.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Content-Security-Policy notes:
# - style-src needs 'unsafe-inline' for one inline style= attribute on the homepage
#   hero (src/pages/index.astro).
# - script-src has NO 'unsafe-inline' — instead it allowlists exact sha256 hashes of
#   the site's inline scripts (verified against the real `npm run build` output in
#   dist/, across every page, not just the homepage):
#     aMzNpU+W... = Navbar.astro's mobile-menu toggle (author-written, all pages)
#     QzWFZi+F... = Astro's client:load hydration bootstrap (ContactForm/FeedbackForm)
#     Ya0pUYrC... = Astro's island props/hydration runtime (homepage, contact, feedback)
#     Q2BPg90Z... = Astro's client:visible hydration bootstrap (homepage)
#   The 3 Astro-generated hashes are framework runtime code and WILL change if the
#   astro/vite version changes, or if hydration directives (client:load/visible/idle)
#   are added/removed/moved between pages — rebuild and recompute if inline scripts
#   start getting blocked again. To regenerate: build the site, then for each unique
#   inline <script>...</script> body (exact text, no trimming) across every dist/**/*.html
#   file, compute base64(sha256(body)) and prefix with 'sha256-'.
# - TODO: once Cloudflare Turnstile is added (see ContactForm.tsx / FeedbackForm.tsx),
#   this CSP will need: script-src https://challenges.cloudflare.com;
#   frame-src https://challenges.cloudflare.com; connect-src https://challenges.cloudflare.com

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-aMzNpU+W+4WqQIb/9I6fkP2FWcSYJe19bS6tzMk+pgw=' 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c=' 'sha256-Ya0pUYrC7nM5Cn/056TyVuEiz6dFGrzmkWzgON0pF0U=' 'sha256-Q2BPg90ZMplYY+FSdApNErhpWafg2hcRRbndmvxuL/Q='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.web3forms.com; form-action 'self' https://api.web3forms.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'
