# Copy this file to .env and fill in real values.
# Only variables prefixed PUBLIC_ are exposed to client-side code (Astro convention) —
# both of these are safe to expose (a form endpoint key and a public booking link).

# Web3Forms access key — https://web3forms.com (free, no backend needed).
# Create an account, verify your destination email, and paste the access key below.
PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here

# Microsoft Bookings page URL for the Business/SME "Book a Free Consultation" flow.
PUBLIC_BOOKINGS_URL=https://outlook.office.com/book/your-booking-page-here
